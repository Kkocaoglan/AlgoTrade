# ── Crypto Module ─────────────────────────────────────────────────────────────
# Set to "False" to switch from Binance Testnet to live trading.
# Paper mode uses Binance Testnet REST for orders; WebSocket is always production (public market data).
PAPER_MODE=True

# Binance API credentials.
# Leave empty to run in public-data-only mode (OHLCV fetch + WebSocket work without keys).
# Required only when PAPER_MODE=False (live orders) or Testnet order placement.
BINANCE_API_KEY=
BINANCE_SECRET=

# ── Telegram alerts ───────────────────────────────────────────────────────────
# Required for all Telegram notifications (BIST + crypto + VIOP).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
